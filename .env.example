# Copy this file to .env for local development.
# Do not commit .env. Replace placeholder values locally.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workshop_market
POSTGRES_USER=workshop_user
POSTGRES_PASSWORD=<set-local-password>

DATABASE_URL=postgresql://workshop_user:<set-local-password>@localhost:5432/workshop_market

RAW_RESPONSE_ROOT=data/raw
LOG_LEVEL=INFO

# Optional API keys. Leave blank unless a permitted source requires them.
GOOGLE_PLACES_API_KEY=
GOOGLE_TRENDS_PROVIDER=
SOCIAL_API_TOKEN=
