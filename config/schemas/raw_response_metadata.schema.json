{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/raw_response_metadata.schema.json",
  "title": "Raw Response Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_id",
    "collection_run_id",
    "source_id",
    "source_record_identifier",
    "parent_collection_id",
    "requested_url",
    "canonical_url",
    "request_method",
    "request_headers_safe",
    "request_parameters_safe",
    "collection_method",
    "collector_name",
    "collector_version",
    "requested_at",
    "response_received_at",
    "collected_at",
    "source_event_time",
    "collection_duration_ms",
    "http_status",
    "content_type",
    "content_encoding",
    "response_size_bytes",
    "content_hash_sha256",
    "raw_storage_path",
    "response_language",
    "final_url",
    "redirect_count",
    "source_review_id",
    "collection_decision",
    "terms_reviewed_at",
    "robots_reviewed_at",
    "permission_basis",
    "attribution_required",
    "retention_policy",
    "contains_personal_data",
    "personal_data_notes",
    "success",
    "error_type",
    "error_message_safe",
    "retry_count",
    "rate_limit_observed",
    "parser_status",
    "validation_status",
    "notes",
    "git_commit_sha",
    "python_version",
    "environment_name",
    "schema_version"
  ],
  "properties": {
    "collection_id": {"type": "string", "minLength": 1},
    "collection_run_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "source_record_identifier": {"type": ["string", "null"]},
    "parent_collection_id": {"type": ["string", "null"]},
    "requested_url": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"]},
    "request_method": {"type": "string", "enum": ["GET", "POST", "HEAD", "MANUAL", "IMPORT"]},
    "request_headers_safe": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "request_parameters_safe": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "collection_method": {"type": "string", "enum": ["api", "html", "feed", "manual", "imported_file", "sitemap", "robots", "terms_review"]},
    "collector_name": {"type": "string", "minLength": 1},
    "collector_version": {"type": "string", "minLength": 1},
    "requested_at": {"type": ["string", "null"], "format": "date-time"},
    "response_received_at": {"type": ["string", "null"], "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"},
    "source_event_time": {"type": ["string", "null"], "format": "date-time"},
    "collection_duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "content_type": {"type": ["string", "null"]},
    "content_encoding": {"type": ["string", "null"]},
    "response_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "content_hash_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "raw_storage_path": {"type": "string", "minLength": 1},
    "response_language": {"type": ["string", "null"]},
    "final_url": {"type": ["string", "null"]},
    "redirect_count": {"type": "integer", "minimum": 0},
    "source_review_id": {"type": "string", "minLength": 1},
    "collection_decision": {
      "type": "string",
      "enum": [
        "approved_official_api",
        "approved_manual_collection",
        "approved_limited_public_collection",
        "pending_review",
        "rejected",
        "not_technically_feasible"
      ]
    },
    "terms_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "robots_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "permission_basis": {"type": "string", "minLength": 1},
    "attribution_required": {"type": "boolean"},
    "retention_policy": {"type": "string", "minLength": 1},
    "contains_personal_data": {"type": "boolean"},
    "personal_data_notes": {"type": ["string", "null"]},
    "success": {"type": "boolean"},
    "error_type": {"type": ["string", "null"]},
    "error_message_safe": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "rate_limit_observed": {"type": "boolean"},
    "parser_status": {"type": "string", "enum": ["not_started", "parsed", "skipped", "failed"]},
    "validation_status": {"type": "string", "enum": ["valid", "invalid", "pending"]},
    "notes": {"type": ["string", "null"]},
    "git_commit_sha": {"type": "string", "pattern": "^[A-Fa-f0-9]{7,40}$"},
    "python_version": {"type": "string", "minLength": 1},
    "environment_name": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "1.0.0"}
  }
}
